// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id              String   @id @default(uuid())
  openId          String?  @unique
  unionId         String?  @unique
  nickname        String?
  avatar          String?
  phone           String?  @unique
  targetExam      String?  // 目标考试类型：国考/省考/事业单位
  targetDate      DateTime?
  education       String?
  major           String?
  politicalStatus String?
  workYears       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  practiceRecords PracticeRecord[]
  wrongQuestions  WrongQuestion[]
  studyPlans      StudyPlan[]
  mockExams       MockExam[]
}

// 题目表
model Question {
  id              String   @id // 使用题目原生ID如 2026_gk_dishi_001
  source          String   // 题目来源：2026国考地市/2025国考副省等
  year            Int
  examType        String   // 国考/省考/事业单位
  examPaper       String?  // 试卷：地市/副省/联考/江苏A等
  category        String   // 大类：常识判断/言语理解/数量关系/判断推理/资料分析
  subCategory     String?  // 子类：政治理论/选词填空/数学运算/图形推理等
  number          Int      // 题号
  difficulty      Int      @default(1) // 1-5
  content         String   // 题干
  options         String   // 选项 JSON字符串 {"A":"...","B":"..."}
  answer          String   // 正确答案
  explanation     String?  // 解析
  imageUrl        String?  // 题目图片（图推、资料分析图表）
  isAiParsed      Boolean  @default(false)
  aiExplanation   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  practiceRecords PracticeRecord[]
  wrongQuestions  WrongQuestion[]

  @@index([category])
  @@index([year, examType])
  @@index([source])
}

// 刷题记录表
model PracticeRecord {
  id           String   @id @default(uuid())
  userId       String
  questionId   String
  userAnswer   String
  isCorrect    Boolean
  timeSpent    Int
  practiceType String   // quick/special/mock
  createdAt    DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@index([userId, createdAt])
  @@index([questionId])
}

// 错题本
model WrongQuestion {
  id           String    @id @default(uuid())
  userId       String
  questionId   String
  wrongCount   Int       @default(1)
  lastWrongAt  DateTime  @default(now())
  nextReviewAt DateTime?
  reviewCount  Int       @default(0)
  mastered     Boolean   @default(false)
  userNote     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@unique([userId, questionId])
  @@index([userId, mastered, nextReviewAt])
}

// 学习计划表
model StudyPlan {
  id        String   @id @default(uuid())
  userId    String
  planType  String
  startDate DateTime
  endDate   DateTime
  tasks     String // JSON
  completed Boolean  @default(false)
  progress  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
}

// 模拟考试记录
model MockExam {
  id            String    @id @default(uuid())
  userId        String
  examType      String
  duration      Int       @default(120)
  questions     String    // JSON: questionId数组
  status        String    @default("in_progress")
  startTime     DateTime?
  endTime       DateTime?
  score         Float?
  correctCount  Int?
  totalCount    Int?
  answers       String?   // JSON: {questionId: answer}
  categoryStats String?   // JSON
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
