{
  "name": "kaogong",
  "version": "1.0.0",
  "private": true,
  "description": "考公智能助手 - 一站式智能备考工具",
  "scripts": {
    "dev": "pnpm --filter @kaogong/web dev",
    "dev:server": "pnpm --filter @kaogong/server dev",
    "dev:web": "pnpm --filter @kaogong/web dev",
    "build": "pnpm --filter @kaogong/web build",
    "build:server": "pnpm --filter @kaogong/server build",
    "build:web": "pnpm --filter @kaogong/web build",
    "preview": "pnpm --filter @kaogong/web preview",
    "db:generate": "pnpm --filter @kaogong/server prisma:generate",
    "db:push": "pnpm --filter @kaogong/server prisma:push",
    "db:seed": "pnpm --filter @kaogong/server prisma:seed",
    "crawl": "cd packages/server && npx ts-node --compiler-options {\"module\":\"commonjs\"} crawler/cli.ts"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma"
    ]
  }
}
